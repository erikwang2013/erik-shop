# Admin — 环境变量模板
# 首次安装时由 Web 安装向导自动生成 .env
# 也可手动复制 .env.example 为 .env 并修改

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erik_shop
DB_USER=root
DB_PASS=

HASHIDS_SALT=change_me_hashids_salt
SNOWFLAKE_WORKER_ID=2
SNOWFLAKE_DATACENTER_ID=1

# AES 加密密钥 (32字节，base64编码)
ENCRYPTION_KEY=base64:aJSrbfDcz5f1Jw6cDK81D3XZ+Bdo9YJ7jXhbHop4URc=
ENCRYPTION_CIPHER=AES-256-CBC
ENCRYPTION_PREVIOUS_KEYS=

# service 内部接口地址与共享密钥（执行真实退款等管理操作）
# ADMIN_SERVICE_URL 指向 service 的监听地址（Docker 部署为 http://service:8787）
ADMIN_SERVICE_URL=http://127.0.0.1:8787
ADMIN_API_KEY=change_me_admin_api_key_64bit
