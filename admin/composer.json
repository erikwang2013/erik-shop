{
  "name": "erik/shop-admin",
  "type": "project",
  "keywords": ["admin", "cross-border", "ecommerce"],
  "homepage": "https://erik.xyz",
  "license": "proprietary",
  "description": "Cross-Border E-Commerce Admin Panel.",
  "authors": [
    {
      "name": "erik",
      "email": "erik@erik.xyz",
      "homepage": "https://erik.xyz",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "webman/admin": "~2.0",
    "erikwang2013/snowflake-php": "^1.0",
    "erikwang2013/hashids": "^1.0",
    "erikwang2013/jwt-webman": "^1.0",
    "erikwang2013/season": "^1.0",
    "erikwang2013/encryption": "^1.0",
    "erikwang2013/encryptable": "^1.0",
    "erikwang2013/poster-php": "^1.0",
    "erikwang2013/webman-scout": "^1.0",
    "phpoffice/phpspreadsheet": "^2.0",
    "barryvdh/laravel-dompdf": "^3.0",
    "guzzlehttp/guzzle": "^7.0",
    "phpoption/phpoption": "^1.9",
    "vlucas/phpdotenv": "^5.6",
    "erikwang2013/security-php": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "erikwang2013/encryptable": true,
      "erikwang2013/webman-scout": true,
      "erikwang2013/jwt-webman": true,
      "erikwang2013/poster-php": true,
      "erikwang2013/season": true,
      "erikwang2013/security-php": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.0"
  }
}
