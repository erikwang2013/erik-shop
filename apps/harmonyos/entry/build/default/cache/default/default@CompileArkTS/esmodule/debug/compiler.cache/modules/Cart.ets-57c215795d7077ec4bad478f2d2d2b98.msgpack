                                    this.observeComponentCreation2((elmtId, isInitialRender) => {
                                        Column.create();
                                        Column.alignItems(HorizontalAlign.Start);
                                        Column.layoutWeight(1);
                                        Column.padding(8);
                                    }, Column);
                                    this.observeComponentCreation2((elmtId, isInitialRender) => {
