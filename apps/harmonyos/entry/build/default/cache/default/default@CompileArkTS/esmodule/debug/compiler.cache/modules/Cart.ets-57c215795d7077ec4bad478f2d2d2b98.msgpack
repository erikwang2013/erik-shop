registerNamedRoute(() => new Cart(undefined, {}), "", { bundleName: "com.erik.shop", moduleName: "entry", pagePath: "pages/Cart", pageFullPath: "entry/src/main/ets/pages/Cart", integratedHsp: "false", moduleType: "followWithHap" });
//# sourceMappingURL=Cart.js.mapÂ’Ùc␀hvigor_ignore__home_component_command-line-tools_sdk_default_openharmony_ets_api_@ohos.router.d.tsÙQ/home/wwwroot/shop-php/apps/harmonyos/entry/src/main/ets/common/api/ApiClient.etsÙG/home/wwwroot/shop-php/apps/harmonyos/entry/src/main/ets/pages/Cart.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ+/home/wwwroot/shop-php/apps/harmonyos/entryÙ%/home/wwwroot/shop-php/apps/harmonyos¥entry¥1.0.0Ô␀␀Ù+/home/wwwroot/shop-php/apps/harmonyos/entryÃÃÚ		/**
