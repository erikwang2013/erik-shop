                                        Text.maxLines(2);
                                        Text.fontSize(14);
                                    }, Text);
                                    Text.pop();
                                    this.observeComponentCreation2((elmtId, isInitialRender) => {
                                        Text.create(`$${item['price']?.toFixed(2)} x ${item['quantity']}`);
                                        Text.fontSize(12);
                                        Text.fontColor('#999');
