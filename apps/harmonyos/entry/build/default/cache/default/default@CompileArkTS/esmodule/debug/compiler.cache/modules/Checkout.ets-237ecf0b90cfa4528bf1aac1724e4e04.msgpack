            Text.create('åˆè®¡: $' + (this.total + this.shippingFee).toFixed(2));
            Text.fontSize(18);
            Text.fontWeight(FontWeight.Bold);
            Text.fontColor('#FF5722');
        }, Text);
        Text.pop();
        Column.pop();
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            Button.createWithLabel('æäº¤è®¢å•');
            Button.onClick(() => this.placeOrder());
        }, Button);
        Button.pop();
        // åº•éƒ¨æ±‡æ€»
        Row.pop();
        Column.pop();
    }
    rerender() {
        this.updateDirtyElements();
    }
    static getEntryName() {
        return "Checkout";
