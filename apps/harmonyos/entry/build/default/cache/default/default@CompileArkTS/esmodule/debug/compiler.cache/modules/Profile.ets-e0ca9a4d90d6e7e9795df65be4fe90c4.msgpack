import { router } from '@kit.ArkUI';

@Entry
@Component
struct Profile {
  @State isLoggedIn: boolean = false;

  build() {
    Column() {
      Text('æˆ‘çš„').fontSize(20).fontWeight(FontWeight.Bold).width('100%').padding(16)

      List() {
        ListItem() {
          Row() {
            Image($r('app.media.avatar_placeholder')).width(64).height(64).borderRadius(32)
            Column() {
              Text(this.isLoggedIn ? 'ç”¨æˆ·å' : 'ç™»å½•/æ³¨å†Œ').fontSize(18)
              Text('æŸ¥çœ‹ä¸ªäººèµ„æ–™').fontSize(12).fontColor('#999')
            }.alignItems(HorizontalAlign.Start).margin({ left: 12 }).layoutWeight(1)
            Image($r('app.media.arrow_right')).width(24).height(24)
          }.width('100%').padding(16)
        }

        ListItem() { this.menuItem('æˆ‘çš„è®¢å•', 'pages/OrderList') }
        ListItem() { this.menuItem('æ”¶è—å¤¹', '') }
        ListItem() { this.menuItem('æ”¶è´§åœ°å€', '') }
        ListItem() { this.menuItem('ç¤¼å“å¡', '') }
        ListItem() { this.menuItem('è¯­è¨€', '', 'ä¸­æ–‡') }
        ListItem() { this.menuItem('å¸ç§', '', 'USD') }
        ListItem() { this.menuItem('éšç§è®¾ç½®', '') }
      }
      .layoutWeight(1)
    }
    .width('100%').height('100%')
  }

  @Builder menuItem(title: string, route: string, rightText: string = '') {
    Row() {
      Text(title).fontSize(16)
      Blank()
      if (rightText) {
        Text(rightText).fontSize(12).fontColor('#999').margin({ right: 4 })
      }
      Image($r('app.media.arrow_right')).width(20).height(20)
    }
    .width('100%').padding(16)
    .onClick(() => { if (route) router.pushUrl({ url: route }) })
  }
}
