graph TB
    START(["وصول طلب HTTP"]) --> CORS["① Cors<br/>ترويسات استجابة Access-Control-*<br/>OPTIONS استعلام مسبق يعيد 200"]

    CORS --> SEC["② Security كشف الهجمات<br/>━━━━━━━━━━━━━━━"]
    SEC --> SEC1{"Content-Type<br/>سليم؟"}
    SEC1 -->|لا| E403["403 Forbidden"]
    SEC1 -->|نعم| SEC2{"Body Size<br/>≤ 10MB؟"}
    SEC2 -->|لا| E413["413 Too Large"]
    SEC2 -->|نعم| SEC3{"كشف XSS<br/>13 قاعدة"}
    SEC3 -->|إصابة| E40001["40001 اعتراض XSS"]
    SEC3 -->|نجاح| SEC4{"كشف SQLi<br/>13 قاعدة"}
    SEC4 -->|إصابة| E40002["40002 اعتراض SQLi"]
    SEC4 -->|نجاح| SEC5{"كشف CRLF<br/>حقن ترويسة"}
    SEC5 -->|إصابة| E40003["40003 اعتراض CRLF"]
    SEC5 -->|نجاح| SEC6{"كشف عبور<br/>المسار"}
    SEC6 -->|إصابة| E40004["40004 اعتراض Path"]
    SEC6 -->|نجاح| SEC_PASS["اجتاز فحص الأمان"]

    SEC_PASS --> PLAT["③ Platform<br/>ترويسة X-Platform<br/>+ ترقية تحديد UA<br/>8 مصادر منصات"]

    PLAT --> GEO["④ GeoIp<br/>MaxMind GeoIP2<br/>المستخدمون غير المسجلين<br/>تحديد المنطقة/العملة/اللغة"]

    GEO --> LOCALE["⑤ Locale<br/>تحليل Accept-Language<br/>مطابقة دقيقة 5 لغات → ترقية → افتراضي"]

    LOCALE --> HDEC["⑥ HashidsDecode<br/>حقول *_id في الطلب<br/>hashid → snowflake ID"]

    HDEC --> VER["⑦ VersionRoute<br/>ترويسة API-Version<br/>→ توجيه فضاء أسماء v1/v2"]

    VER --> RATE["⑧ RateLimit<br/>Redis ZSET نافذة منزلقة<br/>تحديد المعدل بدلو الرموز"]

    RATE -->|تجاوز الحد| E429["429 Too Many Requests<br/>ترويسة Retry-After"]
    RATE -->|نجاح| ROUTE_CHECK{"مطابقة التوجيه؟"}

    ROUTE_CHECK -->|عملية حساسة<br/>تسجيل/طلب/دفع| POSTER["⑨ PosterVerify<br/>التحقق من token في Redis<br/>منزلق/لغز/نقر"]
    ROUTE_CHECK -->|يتطلب مصادقة| JWT_START["⑩ JwtAuth"]
    ROUTE_CHECK -->|واجهة عامة| HENC

    POSTER --> JWT_START

    JWT_START --> JWT_CHECK{"Bearer Token<br/>التحقق من توقيع HS256"}
    JWT_CHECK -->|منتهٍ/باطل| E401["401 Unauthorized"]
    JWT_CHECK -->|سليم| JWT_INJECT["حقن request→userId"]

    JWT_INJECT --> HENC["⑪ HashidsEncode<br/>اجتياز متكرر لـ JSON الاستجابة<br/>snowflake ID → hashid"]

    HENC --> CTRL["Controller<br/>معالجة منطق الأعمال<br/>استعلام Model · تحقق · حساب"]

    CTRL --> ENC_RESP{"يتطلب تشفير الاستجابة؟"}

    ENC_RESP -->|نعم| ENC["⑫ Encryption<br/>تشفير AES-256-CBC<br/>ترويسة X-Encrypted: 1"]
    ENC_RESP -->|لا| RESP
    ENC --> RESP(["JSON Response<br/>{code, msg, data}<br/>+ CORS Headers<br/>+ X-Platform Header"])

    style SEC fill:#ffcdd2
    style RATE fill:#fff9c4
    style POSTER fill:#ffe0b2
    style JWT_START fill:#c8e6c9
    style CTRL fill:#bbdefb
    style START fill:#e8eaf6
    style RESP fill:#e8eaf6
    style E403 fill:#ff5252,color:#fff
    style E413 fill:#ff5252,color:#fff
    style E40001 fill:#ff5252,color:#fff
    style E40002 fill:#ff5252,color:#fff
    style E40003 fill:#ff5252,color:#fff
    style E40004 fill:#ff5252,color:#fff
    style E429 fill:#ff9800,color:#fff
    style E401 fill:#ff5252,color:#fff
