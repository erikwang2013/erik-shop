graph TB
    subgraph Internet["الإنترنت"]
        User["المستخدمون وصول عالمي"]
    end

    subgraph CDN["طبقة حافة CDN"]
        EDGE["CDN Edge<br/>Cloudflare / CloudFront / Aliyun / Tencent<br/>نموذج سحب الأصل Origin-Pull<br/>https://{CDN_DOMAIN}{path}"]
    end

    subgraph VPS["خادم سحابي / VPS"]
        subgraph Docker["Docker Compose"]
            direction TB

            subgraph Net["شبكة الجسر erik-net Bridge Network"]
                direction TB

                NGX["Nginx :80 :443<br/>alpine<br/>وكيل عكسي + إنهاء SSL<br/>تخزين الموارد الساكنة مؤقتًا<br/>location /app/admin/upload/<br/>expires 7d immutable"]

                subgraph PHP_Service["حاوية Service"]
                    SVC["PHP 8.3 + webman 2.1<br/>منفذ داخلي :8787<br/>32 عامل Worker (CPU×4)<br/>OPCache 128MB<br/>Snowflake Worker ID=1"]
                end

                subgraph PHP_Admin["حاوية Admin"]
                    ADM["PHP 8.3 + webman-admin<br/>منفذ داخلي :8788<br/>LayUI + ECharts<br/>RBAC مدمج<br/>Snowflake Worker ID=2"]
                end

                subgraph DB["حاويات قاعدة البيانات"]
                    MYSQL[("MySQL 8.0 :3306<br/>117 جدولًا (110 erik_ + 7 wa_)<br/>حجم البيانات erik_data<br/>character-set utf8mb4")]
                    REDIS[("Redis 7 :6379<br/>حجم البيانات erik_redis<br/>ثبات appendonly AOF<br/>requirepass كلمة مرور")]
                    ES[("Elasticsearch 8.11 :9200<br/>حجم البيانات erik_es<br/>الصورة الرسمية بحث متعدد اللغات")]
                end
            end
        end

        subgraph Volumes["أحجام البيانات الثابتة"]
            V1["erik_data بيانات MySQL"]
            V2["erik_redis بيانات Redis"]
            V3["erik_es فهرس ES"]
            V4["erik_logs سجلات التطبيق"]
            V5["admin_uploads ملفات رفع Admin<br/>(plugin/admin/public/upload)"]
            V6["service_public ملفات Service العامة<br/>(public/documents)"]
        end
    end

    subgraph External["الخدمات الخارجية"]
        Stripe["Stripe API<br/>PaymentIntent + 3DS"]
        PayPal["PayPal REST<br/>Orders API v2"]
        Klarna["Klarna API<br/>BNPL اشترِ الآن وادفع لاحقًا"]
        SMTP["خدمة البريد<br/>قوالب متعددة اللغات<br/>(جدول email_templates)"]
    end

    User --> EDGE
    EDGE -->|CNAME إلى admin| NGX
    NGX -->|api.erik.xyz| SVC
    NGX -->|admin.erik.xyz| ADM
    SVC --> MYSQL
    SVC --> REDIS
    SVC --> ES
    SVC --> Stripe
    SVC --> PayPal
    SVC --> Klarna
    SVC --> SMTP
    ADM --> MYSQL
    ADM --> REDIS
    MYSQL -.-> V1
    REDIS -.-> V2
    ES -.-> V3
    SVC -.-> V4
    ADM -.-> V5
    SVC -.-> V6

    style Internet fill:#e8eaf6
    style CDN fill:#fff3e0
    style VPS fill:#e8f5e9
    style Docker fill:#f3e5f5
    style Net fill:#e1f5fe
    style PHP_Service fill:#c8e6c9
    style PHP_Admin fill:#fff9c4
    style DB fill:#fce4ec
    style Volumes fill:#efebe9
    style External fill:#e0f2f1
