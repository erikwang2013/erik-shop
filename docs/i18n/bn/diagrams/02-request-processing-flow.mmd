graph TB
    START(["HTTP রিকোয়েস্ট পৌঁছেছে"]) --> CORS["① Cors<br/>Access-Control-* রেসপন্স হেডার<br/>OPTIONS প্রি-ফ্লাইট 200 রিটার্ন"]

    CORS --> SEC["② Security অ্যাটাক ডিটেকশন<br/>━━━━━━━━━━━━━━━"]
    SEC --> SEC1{"Content-Type<br/>বৈধ?"}
    SEC1 -->|না| E403["403 Forbidden"]
    SEC1 -->|হ্যাঁ| SEC2{"Body Size<br/>≤ 10MB?"}
    SEC2 -->|না| E413["413 Too Large"]
    SEC2 -->|হ্যাঁ| SEC3{"XSS ডিটেকশন<br/>13টি নিয়ম"}
    SEC3 -->|হিট| E40001["40001 XSS ব্লক করা হয়েছে"]
    SEC3 -->|পাস| SEC4{"SQLi ডিটেকশন<br/>13টি নিয়ম"}
    SEC4 -->|হিট| E40002["40002 SQLi ব্লক করা হয়েছে"]
    SEC4 -->|পাস| SEC5{"CRLF ডিটেকশন<br/>Header ইনজেকশন"}
    SEC5 -->|হিট| E40003["40003 CRLF ব্লক করা হয়েছে"]
    SEC5 -->|পাস| SEC6{"পাথ ট্রাভার্সাল<br/>ডিটেকশন"}
    SEC6 -->|হিট| E40004["40004 Path ব্লক করা হয়েছে"]
    SEC6 -->|পাস| SEC_PASS["নিরাপত্তা পরীক্ষা পাস"]

    SEC_PASS --> PLAT["③ Platform<br/>X-Platform Header<br/>+ UA ফলব্যাক সনাক্তকরণ<br/>8টি প্ল্যাটফর্ম উৎস"]

    PLAT --> GEO["④ GeoIp<br/>MaxMind GeoIP2<br/>লগইনবিহীন ব্যবহারকারী<br/>অঞ্চল/মুদ্রা/ভাষা সনাক্তকরণ"]

    GEO --> LOCALE["⑤ Locale<br/>Accept-Language পার্সিং<br/>5টি ভাষা নির্ভুল ম্যাচ → ফলব্যাক → ডিফল্ট"]

    LOCALE --> HDEC["⑥ HashidsDecode<br/>রিকোয়েস্টের *_id ফিল্ড<br/>hashid → snowflake ID"]

    HDEC --> VER["⑦ VersionRoute<br/>API-Version Header<br/>→ v1/v2 নেমস্পেস রাউট"]

    VER --> RATE["⑧ RateLimit<br/>Redis ZSET স্লাইডিং উইন্ডো<br/>টোকেন বাকেট রেট লিমিট"]

    RATE -->|লিমিট অতিক্রম| E429["429 Too Many Requests<br/>Retry-After রেসপন্স হেডার"]
    RATE -->|পাস| ROUTE_CHECK{"রাউট ম্যাচ?"}

    ROUTE_CHECK -->|সংবেদনশীল অপারেশন<br/>রেজিস্ট্রেশন/অর্ডার/পেমেন্ট| POSTER["⑨ PosterVerify<br/>Redis ভেরিফিকেশন token<br/>স্লাইডার/পাজল/ক্লিক"]
    ROUTE_CHECK -->|অথেনটিকেশন প্রয়োজন| JWT_START["⑩ JwtAuth"]
    ROUTE_CHECK -->|পাবলিক API| HENC

    POSTER --> JWT_START

    JWT_START --> JWT_CHECK{"Bearer Token<br/>HS256 ভেরিফিকেশন"}
    JWT_CHECK -->|অবৈধ/মেয়াদোত্তীর্ণ| E401["401 Unauthorized"]
    JWT_CHECK -->|বৈধ| JWT_INJECT["request→userId ইনজেকশন"]

    JWT_INJECT --> HENC["⑪ HashidsEncode<br/>রেসপন্স JSON রিকার্সিভ ট্রাভার্সাল<br/>snowflake ID → hashid"]

    HENC --> CTRL["Controller<br/>বিজনেস লজিক প্রসেসিং<br/>Model কোয়েরি · ভ্যালিডেশন · ক্যালকুলেশন"]

    CTRL --> ENC_RESP{"এনক্রিপশন দরকার?"}

    ENC_RESP -->|হ্যাঁ| ENC["⑫ Encryption<br/>AES-256-CBC এনক্রিপশন<br/>X-Encrypted: 1 Header"]
    ENC_RESP -->|না| RESP
    ENC --> RESP(["JSON Response<br/>{code, msg, data}<br/>+ CORS Headers<br/>+ X-Platform Header"])

