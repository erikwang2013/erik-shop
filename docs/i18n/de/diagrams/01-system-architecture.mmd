graph TB
    subgraph Clients["Client-Ebene Client Layer"]
        direction LR
        FL["Flutter App<br/>iOS · Android · macOS<br/>Windows · Linux · iPadOS<br/>Riverpod + GoRouter + Dio"]
        HM["HarmonyOS App<br/>ArkTS + ArkUI<br/>API 12+"]
        WB["Web Admin<br/>LayUI + ECharts<br/>Verwaltungskonsole"]
    end

    subgraph Gateway["Zugangsebene Gateway"]
        NG["Nginx :80 / :443<br/>api.erik.xyz → Service<br/>admin.erik.xyz → Admin<br/>statische Assets + SSL-Terminierung"]
    end

    subgraph Apps["Anwendungsebene Application"]
        subgraph Service["Service API (webman) :8787"]
            direction TB
            MW["10 globale Middleware<br/>Cors → Security → RateLimit<br/>→ Platform → GeoIp → Locale<br/>→ HashidsDecode → VersionRoute<br/>→ HashidsEncode → Encryption"]
            RT["2 Routen-Middleware<br/>PosterVerify · JwtAuth"]
            CTRL["39 Controller<br/>Auth · Product · Cart · Order<br/>Payment · Shipping · Tariff<br/>User · Coupon · Return<br/>Notify · Export · Affiliate<br/>B2b · Cms · Faq · FlashSale<br/>GroupBuy · GiftCard · Review<br/>Search · SocialAuth · Settings"]
            MDL["111 Modelle<br/>BaseModel: Snowflake ID<br/>+ Encryptable-Verschlüsselung<br/>+ Searchable ES-Sync<br/>+ SoftDelete<br/>45 Tabellen mit SoftDelete"]
        end
        subgraph Admin["Admin (webman-admin) :8788"]
            direction TB
            AMW["5 Middleware<br/>Security → Platform<br/>→ HashidsDecode<br/>→ AccessControl RBAC<br/>→ HashidsEncode"]
            ACTRL["82 Controller<br/>Produkte · Bestellungen · Benutzer · Marketing<br/>Logistik · Lieferkette · Risiko<br/>CMS · Support · System"]
            AMDL["76 Modelle"]
        end
    end

    subgraph Data["Datenebene Data"]
        direction LR
        MySQL[("MySQL 8.0 :3306<br/>117 Tabellen · erik_-Präfix<br/>Snowflake bigint PK<br/>Read/Write-Splitting, 2 Lesereplikate")]
        Redis[("Redis 7 :6379<br/>Rate-Limit-Token-Bucket<br/>Session · Poster-Verifikation")]
        ES[("Elasticsearch 8 :9200<br/>mehrsprachige Token-Suche<br/>Produkte · Kategorien · CMS")]
    end

    subgraph External["Externe Dienste External"]
        direction LR
        Pay["Zahlungs-Gateway<br/>Stripe · PayPal<br/>Klarna · Adyen<br/>Webhook, asynchrone Benachrichtigung"]
        Geo["GeoIP<br/>MaxMind GeoIP2<br/>Region · Währungserkennung"]
        Email["E-Mail-Dienst<br/>mehrsprachige Vorlagen<br/>(Tabelle email_templates)"]
    end

    FL --> NG
    HM --> NG
    WB --> NG
    NG --> Service
    NG --> Admin
    Service --> MySQL
    Service --> Redis
    Service --> ES
    Service --> Pay
    Service --> Geo
    Service --> Email
    Admin --> MySQL
    Admin --> Redis

