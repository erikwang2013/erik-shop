graph TB
    subgraph Request["Eingang"]
        REQ["HTTP Request"]
    end

    subgraph L1["Ebene 1: Netzwerkperimeter"]
        direction TB
        NG["Nginx-Reverse-Proxy<br/>· SSL/TLS-Terminierung<br/>· Begrenzung der Request-Größe<br/>· kein direkter Zugriff über nackte IPs"]
        CORS_W["CORS-Whitelist<br/>· Access-Control-Allow-Origin<br/>· konfigurierbare Origin-Beschränkung"]
    end

    subgraph L2["Ebene 2: WAF-Angriffserkennung<br/>(SecurityMiddleware)"]
        direction TB
        CT{"Content-Type<br/>Prüfung"}
        BS{"Body Size<br/>≤ 10MB"}
        XSS{"XSS-Erkennung<br/>13 Regex-Regeln"}
        SQLI{"SQLi-Erkennung<br/>13 Regex-Regeln"}
        CRLF{"CRLF-Injection<br/>Header-Erkennung"}
        PATH_T{"Pfad-Traversal<br/>Encoding/Null-Byte"}
        XXE{"XXE-Entity-Injection<br/>ENTITY/DOCTYPE"}
        SSRF{"SSRF-Fälschung<br/>Intranet-IP-Erkennung"}
        FILE_CHK{"Datei-Upload<br/>Blacklist/Doppelte Endung"}
        METHOD{"HTTP-Methoden<br/>Whitelist-Prüfung"}
        HOST{"Host-Header<br/>Prüfung"}

        CT -->|Ungültig| E403["403"]
        CT -->|Pass| BS
        BS -->|Limit überschritten| E413["413"]
        BS -->|Pass| XSS
        XSS -->|Treffer| E40001["40001"]
        XSS -->|Pass| SQLI
        SQLI -->|Treffer| E40002["40002"]
        SQLI -->|Pass| CRLF
        CRLF -->|Treffer| E40003["40003"]
        CRLF -->|Pass| PATH_T
        PATH_T -->|Treffer| E40004["40004"]
        PATH_T -->|Pass| XXE
        XXE -->|Treffer| E40010["40010"]
        XXE -->|Pass| SSRF
        SSRF -->|Treffer| E40011["40011"]
        SSRF -->|Pass| FILE_CHK
        FILE_CHK -->|Treffer| E40009["40009"]
        FILE_CHK -->|Pass| METHOD
        METHOD -->|Ungültig| E40012["40012"]
        METHOD -->|Pass| HOST
    end

    subgraph L3["Ebene 3: Traffic-Kontrolle"]
        direction TB
        BRUTE["Brute-Force-Schutz<br/>Redis-Zähler<br/>API: 10×/60s<br/>Admin: 5×/300s"]
        RATE["Token-Bucket-Limiting<br/>Redis ZSET Sliding Window<br/>6 Endpunkte mit eigenen Regeln"]
        BRUTE --> RATE
    end

    subgraph L4["Ebene 4: Authentifizierung"]
        direction TB
        POSTER["PosterVerify-CAPTCHA<br/>· Schieberegler · Puzzle · Klick<br/>· bei Registrierung/Bestellung/Zahlung"]
        JWT_AUTH["JWT-Authentifizierung<br/>· HS256-Signatur<br/>· Ablaufprüfung<br/>· Dual-Token-Refresh<br/>· request→userId-Injektion"]
        POSTER --> JWT_AUTH
    end

    subgraph L5["Ebene 5: Datensicherheit"]
        direction TB
        HASHIDS["Hashids-ID-Verschleierung<br/>· Anfrage: hashid→snowflake<br/>· Antwort: snowflake→hashid<br/>· verhindert ID-Enumeration"]
        AES_ENC["AES-256-CBC-Verschlüsselung<br/>· Transport: sensible POST-Body-Felder<br/>· Antwort: X-Encrypted-Header<br/>· Datenbank: Encryptable-Trait<br/>email/mobile/name/tax_id"]
        SENS_MASK["Maskierung sensibler Daten<br/>· Log-Filter password/token/secret<br/>· Fehlerantworten maskiert<br/>· keine internen Informationen preisgeben"]
    end

    subgraph L6["Ebene 6: Antwortsicherheit"]
        direction TB
        SEC_HEADERS["HTTP-Sicherheitsheader<br/>· X-Content-Type-Options: nosniff<br/>· X-Frame-Options: DENY<br/>· X-XSS-Protection<br/>· Referrer-Policy<br/>· Permissions-Policy<br/>· Server ausblenden<br/>· Cache-Control"]
    end

    subgraph Audit["Audit-Trail"]
        direction LR
        PLATFORM["Plattform-Tracking<br/>X-Platform-Header<br/>8 Plattformerkennung<br/>6 Tabellen"]
        OP_LOG["Betriebsprotokoll<br/>erik_operation_logs<br/>platform · user_id<br/>action · ip · ua"]
    end

    REQ --> NG
    NG --> CORS_W
    CORS_W --> L2
    HOST --> BRUTE
    RATE --> POSTER

    L5 --> L6
    L6 --> RESP(["Sichere Antwort"])

    PLATFORM -.-> OP_LOG
    L2 -.-> PLATFORM
    L4 -.-> PLATFORM

