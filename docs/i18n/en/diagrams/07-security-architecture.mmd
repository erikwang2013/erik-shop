graph TB
    subgraph Request["Entry"]
        REQ["HTTP Request"]
    end

    subgraph L1["Layer 1 · Network Boundary"]
        direction TB
        NG["Nginx Reverse Proxy<br/>· SSL/TLS Termination<br/>· Request Body Size Limit<br/>· Rejects Bare IP Direct Access"]
        CORS_W["CORS Whitelist<br/>· Access-Control-Allow-Origin<br/>· Configurable Origin Restrictions"]
    end

    subgraph L2["Layer 2 · WAF Attack Detection<br/>(SecurityMiddleware)"]
        direction TB
        CT{"Content-Type<br/>Check"}
        BS{"Body Size<br/>≤ 10MB"}
        XSS{"XSS Detection<br/>13 Regex Rules"}
        SQLI{"SQLi Detection<br/>13 Regex Rules"}
        CRLF{"CRLF Injection<br/>Header Detection"}
        PATH_T{"Path Traversal<br/>Encoding/null byte"}
        XXE{"XXE Entity Injection<br/>ENTITY/DOCTYPE"}
        SSRF{"SSRF Spoofing<br/>Internal IP Detection"}
        FILE_CHK{"File Upload<br/>Blacklist/Double Extension"}
        METHOD{"HTTP Method<br/>Whitelist Check"}
        HOST{"Host Header<br/>Check"}

        CT -->|Invalid| E403["403"]
        CT -->|Pass| BS
        BS -->|Exceeded| E413["413"]
        BS -->|Pass| XSS
        XSS -->|Hit| E40001["40001"]
        XSS -->|Pass| SQLI
        SQLI -->|Hit| E40002["40002"]
        SQLI -->|Pass| CRLF
        CRLF -->|Hit| E40003["40003"]
        CRLF -->|Pass| PATH_T
        PATH_T -->|Hit| E40004["40004"]
        PATH_T -->|Pass| XXE
        XXE -->|Hit| E40010["40010"]
        XXE -->|Pass| SSRF
        SSRF -->|Hit| E40011["40011"]
        SSRF -->|Pass| FILE_CHK
        FILE_CHK -->|Hit| E40009["40009"]
        FILE_CHK -->|Pass| METHOD
        METHOD -->|Invalid| E40012["40012"]
        METHOD -->|Pass| HOST
    end

    subgraph L3["Layer 3 · Traffic Control"]
        direction TB
        BRUTE["Brute Force Protection<br/>Redis Counter<br/>API: 10/60s<br/>Admin: 5/300s"]
        RATE["Token Bucket Rate Limiting<br/>Redis ZSET Sliding Window<br/>6 Endpoint Independent Rules"]
        BRUTE --> RATE
    end

    subgraph L4["Layer 4 · Identity Authentication"]
        direction TB
        POSTER["PosterVerify Human Verification<br/>· Slider · Puzzle · Click<br/>· Triggered on Register/Order/Payment"]
        JWT_AUTH["JWT Authentication<br/>· HS256 Signature<br/>· Expiry Check<br/>· Dual-Token Refresh<br/>· request→userId Injection"]
        POSTER --> JWT_AUTH
    end

    subgraph L5["Layer 5 · Data Security"]
        direction TB
        HASHIDS["Hashids ID Obfuscation<br/>· Request: hashid→snowflake<br/>· Response: snowflake→hashid<br/>· Prevents ID Enumeration"]
        AES_ENC["AES-256-CBC Encryption<br/>· Transport: Sensitive POST Body Fields<br/>· Response: X-Encrypted Header<br/>· Database: Encryptable Trait<br/>email/mobile/name/tax_id"]
        SENS_MASK["Sensitive Data Masking<br/>· Logs Filter password/token/secret<br/>· Masked Error Responses<br/>· No Internal Info Leakage"]
    end

    subgraph L6["Layer 6 · Response Security"]
        direction TB
        SEC_HEADERS["HTTP Security Headers<br/>· X-Content-Type-Options: nosniff<br/>· X-Frame-Options: DENY<br/>· X-XSS-Protection<br/>· Referrer-Policy<br/>· Permissions-Policy<br/>· Server Hidden<br/>· Cache-Control"]
    end

    subgraph Audit["Audit Trail"]
        direction LR
        PLATFORM["Platform Tracking<br/>X-Platform header<br/>8 Platform Detection<br/>Recorded in 6 Tables"]
        OP_LOG["Operation Logs<br/>erik_operation_logs<br/>platform · user_id<br/>action · ip · ua"]
    end

    REQ --> NG
    NG --> CORS_W
    CORS_W --> L2
    HOST --> BRUTE
    RATE --> POSTER

    L5 --> L6
    L6 --> RESP(["Secure Response"])

    PLATFORM -.-> OP_LOG
    L2 -.-> PLATFORM
    L4 -.-> PLATFORM

