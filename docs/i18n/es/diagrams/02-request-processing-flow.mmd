graph TB
    START(["Llega una petición HTTP"]) --> CORS["① Cors<br/>Cabeceras de respuesta Access-Control-*<br/>OPTIONS preflight devuelve 200"]

    CORS --> SEC["② Security detección de ataques<br/>━━━━━━━━━━━━━━━"]
    SEC --> SEC1{"Content-Type<br/>¿válido?"}
    SEC1 -->|No| E403["403 Forbidden"]
    SEC1 -->|Sí| SEC2{"Body Size<br/>≤ 10MB?"}
    SEC2 -->|No| E413["413 Too Large"]
    SEC2 -->|Sí| SEC3{"Detección XSS<br/>13 reglas"}
    SEC3 -->|Acierto| E40001["40001 XSS bloqueado"]
    SEC3 -->|Pasa| SEC4{"Detección SQLi<br/>13 reglas"}
    SEC4 -->|Acierto| E40002["40002 SQLi bloqueado"]
    SEC4 -->|Pasa| SEC5{"Detección CRLF<br/>inyección de Header"}
    SEC5 -->|Acierto| E40003["40003 CRLF bloqueado"]
    SEC5 -->|Pasa| SEC6{"Recorrido de rutas<br/>detección"}
    SEC6 -->|Acierto| E40004["40004 Path bloqueado"]
    SEC6 -->|Pasa| SEC_PASS["Detección de seguridad superada"]

    SEC_PASS --> PLAT["③ Platform<br/>Header X-Platform<br/>+ Reconocimiento degradado por UA<br/>8 plataformas de origen"]

    PLAT --> GEO["④ GeoIp<br/>MaxMind GeoIP2<br/>Usuarios no autenticados<br/>Reconocimiento de región/moneda/idioma"]

    GEO --> LOCALE["⑤ Locale<br/>Análisis de Accept-Language<br/>Coincidencia exacta 5 idiomas → degradación → por defecto"]

    LOCALE --> HDEC["⑥ HashidsDecode<br/>Campos *_id de la petición<br/>hashid → snowflake ID"]

    HDEC --> VER["⑦ VersionRoute<br/>Header API-Version<br/>→ ruta por namespace v1/v2"]

    VER --> RATE["⑧ RateLimit<br/>Ventana deslizante Redis ZSET<br/>Limitación token bucket"]

    RATE -->|Superado el límite| E429["429 Too Many Requests<br/>Cabecera de respuesta Retry-After"]
    RATE -->|Pasa| ROUTE_CHECK{"¿Coincidencia de ruta?"}

    ROUTE_CHECK -->|Operaciones sensibles<br/>registro/pedido/pago| POSTER["⑨ PosterVerify<br/>Verificación del token en Redis<br/>Deslizador/puzzle/clic"]
    ROUTE_CHECK -->|Requiere autenticación| JWT_START["⑩ JwtAuth"]
    ROUTE_CHECK -->|Interfaz pública| HENC

    POSTER --> JWT_START

    JWT_START --> JWT_CHECK{"Bearer Token<br/>Verificación de firma HS256"}
    JWT_CHECK -->|Inválido/expirado| E401["401 Unauthorized"]
    JWT_CHECK -->|Válido| JWT_INJECT["Inyección request→userId"]

    JWT_INJECT --> HENC["⑪ HashidsEncode<br/>Recorrido recursivo del JSON de respuesta<br/>snowflake ID → hashid"]

    HENC --> CTRL["Controller<br/>Procesamiento de lógica de negocio<br/>Consulta de Model · validación · cálculo"]

    CTRL --> ENC_RESP{"¿Respuesta a cifrar?"}

    ENC_RESP -->|Sí| ENC["⑫ Encryption<br/>Cifrado AES-256-CBC<br/>Header X-Encrypted: 1"]
    ENC_RESP -->|No| RESP
    ENC --> RESP(["JSON Response<br/>{code, msg, data}<br/>+ CORS Headers<br/>+ X-Platform Header"])

