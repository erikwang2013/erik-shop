graph TB
    subgraph Internet["Internet"]
        User["Usuarios acceso global"]
        CdnEdge["CDN Edge: Cloudflare / CloudFront / Aliyun / Tencent<br/>Origin-pull: cdn.erik.xyz → dominio de admin<br/>Caché immutable 7 días"]
    end

    subgraph VPS["Servidor en la nube / VPS"]
        subgraph Docker["Docker Compose"]
            direction TB

            subgraph Net["erik-net Bridge Network"]
                direction TB

                NGX["Nginx :80 :443<br/>alpine<br/>Proxy inverso + terminación SSL<br/>Caché de recursos estáticos"]

                subgraph PHP_Service["Service Container"]
                    SVC["PHP 8.3 + webman 2.1<br/>Puerto interno :8787<br/>32 Workers (CPU×4)<br/>OPCache 128MB<br/>Snowflake Worker ID=1"]
                end

                subgraph PHP_Admin["Admin Container"]
                    ADM["PHP 8.3 + webman-admin<br/>Puerto interno :8788<br/>LayUI + ECharts<br/>RBAC integrado<br/>Snowflake Worker ID=2"]
                end

                subgraph DB["Contenedor de base de datos"]
                    MYSQL[("MySQL 8.0 :3306<br/>117 tablas (110 erik_ + 7 wa_)<br/>Volumen de datos erik_data<br/>character-set utf8mb4")]
                    REDIS[("Redis 7 :6379<br/>Volumen de datos erik_redis<br/>Persistencia AOF appendonly<br/>Contraseña requirepass")]
                    ES[("Elasticsearch 8.11 :9200<br/>Volumen de datos erik_es<br/>Imagen oficial búsqueda multilingüe")]
                end
            end
        end

        subgraph Volumes["Volúmenes de datos persistentes"]
            V1["erik_data datos MySQL"]
            V2["erik_redis datos Redis"]
            V3["erik_es índice ES"]
            V4["erik_logs logs de aplicación"]
            V5["admin_uploads: /app/plugin/admin/public/upload<br/>Subidas del origin de admin (persistentes)"]
            V6["service_public: /app/public/documents<br/>Documentos públicos del service (persistentes)"]
        end
    end

    subgraph External["Servicios externos"]
        Stripe["Stripe API<br/>PaymentIntent + 3DS"]
        PayPal["PayPal REST<br/>Orders API v2"]
        Klarna["Klarna API<br/>BNPL compra ahora paga después"]
        SMTP["Servicio de correo<br/>Plantillas multilingües<br/>(tabla email_templates)"]
    end

    User --> CdnEdge
    CdnEdge --> NGX
    NGX -->|api.erik.xyz| SVC
    NGX -->|admin.erik.xyz| ADM
    SVC --> MYSQL
    SVC --> REDIS
    SVC --> ES
    SVC --> Stripe
    SVC --> PayPal
    SVC --> Klarna
    SVC --> SMTP
    ADM --> MYSQL
    ADM --> REDIS
    MYSQL -.-> V1
    REDIS -.-> V2
    ES -.-> V3
    SVC -.-> V4
    SVC -.-> V6
    ADM -.-> V5

    style Internet fill:#e8eaf6
    style VPS fill:#e8f5e9
    style Docker fill:#f3e5f5
    style Net fill:#e1f5fe
    style PHP_Service fill:#c8e6c9
    style PHP_Admin fill:#fff9c4
    style DB fill:#fce4ec
    style Volumes fill:#efebe9
    style External fill:#e0f2f1
