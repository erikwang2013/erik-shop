graph TB
    subgraph Request["Entrada"]
        REQ["HTTP Request"]
    end

    subgraph L1["Primera capa: límite de red"]
        direction TB
        NG["Proxy inverso Nginx<br/>· Terminación SSL/TLS<br/>· Límite de tamaño del cuerpo de petición<br/>· Rechazo de conexión directa por IP desnuda"]
        CORS_W["Whitelist CORS<br/>· Access-Control-Allow-Origin<br/>· Restricción de origin configurable"]
    end

    subgraph L2["Segunda capa: detección de ataques WAF<br/>(SecurityMiddleware)"]
        direction TB
        CT{"Content-Type<br/>validación"}
        BS{"Body Size<br/>≤ 10MB"}
        XSS{"Detección XSS<br/>13 regex"}
        SQLI{"Detección SQLi<br/>13 regex"}
        CRLF{"Inyección CRLF<br/>detección de Header"}
        PATH_T{"Recorrido de rutas<br/>codificación/null byte"}
        XXE{"Inyección de entidades XXE<br/>ENTITY/DOCTYPE"}
        SSRF{"Suplantación SSRF<br/>detección de IP de red interna"}
        FILE_CHK{"Subida de archivos<br/>lista negra/doble extensión"}
        METHOD{"Método HTTP<br/>validación de whitelist"}
        HOST{"Header Host<br/>validación"}

        CT -->|Inválido| E403["403"]
        CT -->|Pasa| BS
        BS -->|Superado| E413["413"]
        BS -->|Pasa| XSS
        XSS -->|Acierto| E40001["40001"]
        XSS -->|Pasa| SQLI
        SQLI -->|Acierto| E40002["40002"]
        SQLI -->|Pasa| CRLF
        CRLF -->|Acierto| E40003["40003"]
        CRLF -->|Pasa| PATH_T
        PATH_T -->|Acierto| E40004["40004"]
        PATH_T -->|Pasa| XXE
        XXE -->|Acierto| E40010["40010"]
        XXE -->|Pasa| SSRF
        SSRF -->|Acierto| E40011["40011"]
        SSRF -->|Pasa| FILE_CHK
        FILE_CHK -->|Acierto| E40009["40009"]
        FILE_CHK -->|Pasa| METHOD
        METHOD -->|Inválido| E40012["40012"]
        METHOD -->|Pasa| HOST
    end

    subgraph L3["Tercera capa: control de tráfico"]
        direction TB
        BRUTE["Protección anti-fuerza bruta<br/>Contador Redis<br/>API: 10 veces/60s<br/>Admin: 5 veces/300s"]
        RATE["Limitación token bucket<br/>Ventana deslizante Redis ZSET<br/>6 endpoints con reglas independientes"]
        BRUTE --> RATE
    end

    subgraph L4["Cuarta capa: autenticación de identidad"]
        direction TB
        POSTER["Verificación humano-máquina PosterVerify<br/>· Deslizador · puzzle · clic<br/>· Se activa en registro/pedido/pago"]
        JWT_AUTH["Autenticación JWT<br/>· Firma HS256<br/>· Comprobación de expiración<br/>· Doble token de refresco<br/>· Inyección request→userId"]
        POSTER --> JWT_AUTH
    end

    subgraph L5["Quinta capa: seguridad de datos"]
        direction TB
        HASHIDS["Ofuscación de ID Hashids<br/>· Petición: hashid→snowflake<br/>· Respuesta: snowflake→hashid<br/>· Previene la enumeración de IDs"]
        AES_ENC["Cifrado AES-256-CBC<br/>· Transporte: campos sensibles del body POST<br/>· Respuesta: header X-Encrypted<br/>· Base de datos: trait Encryptable<br/>email/mobile/name/tax_id"]
        SENS_MASK["Enmascaramiento de datos sensibles<br/>· Los logs filtran password/token/secret<br/>· Respuestas de error enmascaradas<br/>· Sin fuga de información interna"]
    end

    subgraph L6["Sexta capa: seguridad de respuesta"]
        direction TB
        SEC_HEADERS["Cabeceras de seguridad HTTP<br/>· X-Content-Type-Options: nosniff<br/>· X-Frame-Options: DENY<br/>· X-XSS-Protection<br/>· Referrer-Policy<br/>· Permissions-Policy<br/>· Ocultación de Server<br/>· Cache-Control"]
    end

    subgraph Audit["Auditoría y trazabilidad"]
        direction LR
        PLATFORM["Seguimiento de plataforma<br/>Header X-Platform<br/>Reconocimiento de 8 plataformas<br/>Registro en 6 tablas"]
        OP_LOG["Logs de operación<br/>erik_operation_logs<br/>platform · user_id<br/>action · ip · ua"]
    end

    REQ --> NG
    NG --> CORS_W
    CORS_W --> L2
    HOST --> BRUTE
    RATE --> POSTER

    L5 --> L6
    L6 --> RESP(["Respuesta segura"])

    PLATFORM -.-> OP_LOG
    L2 -.-> PLATFORM
    L4 -.-> PLATFORM

    style L1 fill:#e3f2fd
    style L2 fill:#ffcdd2
    style L3 fill:#fff9c4
    style L4 fill:#c8e6c9
    style L5 fill:#e1bee7
    style L6 fill:#b2dfdb
    style Audit fill:#f5f5f5
    style E403 fill:#ff5252,color:#fff
    style E413 fill:#ff5252,color:#fff
    style E40001 fill:#ff5252,color:#fff
    style E40002 fill:#ff5252,color:#fff
    style E40003 fill:#ff5252,color:#fff
    style E40004 fill:#ff5252,color:#fff
    style E40009 fill:#ff5252,color:#fff
    style E40010 fill:#ff5252,color:#fff
    style E40011 fill:#ff5252,color:#fff
    style E40012 fill:#ff5252,color:#fff
