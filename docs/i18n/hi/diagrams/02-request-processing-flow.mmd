graph TB
    START(["HTTP अनुरोध आगमन"]) --> CORS["① Cors<br/>Access-Control-* रिस्पॉन्स हेडर<br/>OPTIONS प्रीफ़्लाइट 200 लौटाता है"]

    CORS --> SEC["② Security हमले की पहचान<br/>━━━━━━━━━━━━━━━"]
    SEC --> SEC1{"Content-Type<br/>मान्य?"}
    SEC1 -->|नहीं| E403["403 Forbidden"]
    SEC1 -->|हाँ| SEC2{"Body Size<br/>≤ 10MB?"}
    SEC2 -->|नहीं| E413["413 Too Large"]
    SEC2 -->|हाँ| SEC3{"XSS जाँच<br/>13 नियम"}
    SEC3 -->|हिट| E40001["40001 XSS अवरुद्ध"]
    SEC3 -->|पास| SEC4{"SQLi जाँच<br/>13 नियम"}
    SEC4 -->|हिट| E40002["40002 SQLi अवरुद्ध"]
    SEC4 -->|पास| SEC5{"CRLF जाँच<br/>हेडर इंजेक्शन"}
    SEC5 -->|हिट| E40003["40003 CRLF अवरुद्ध"]
    SEC5 -->|पास| SEC6{"पाथ ट्रैवर्सल<br/>जाँच"}
    SEC6 -->|हिट| E40004["40004 Path अवरुद्ध"]
    SEC6 -->|पास| SEC_PASS["सुरक्षा जाँच पास"]

    SEC_PASS --> PLAT["③ Platform<br/>X-Platform Header<br/>+ UA फ़ॉलबैक पहचान<br/>8 प्लेटफ़ॉर्म स्रोत"]

    PLAT --> GEO["④ GeoIp<br/>MaxMind GeoIP2<br/>अनलॉग्ड उपयोगकर्ता<br/>क्षेत्र/मुद्रा/भाषा पहचान"]

    GEO --> LOCALE["⑤ Locale<br/>Accept-Language पार्सिंग<br/>5 भाषासटीक मिलान → फ़ॉलबैक → डिफ़ॉल्ट"]

    LOCALE --> HDEC["⑥ HashidsDecode<br/>अनुरोध में *_id फ़ील्ड<br/>hashid → snowflake ID"]

    HDEC --> VER["⑦ VersionRoute<br/>API-Version Header<br/>→ v1/v2 नेमस्पेस रूटिंग"]

    VER --> RATE["⑧ RateLimit<br/>Redis ZSET स्लाइडिंग विंडो<br/>टोकन बकेट रेट लिमिट"]

    RATE -->|सीमा से अधिक| E429["429 Too Many Requests<br/>Retry-After रिस्पॉन्स हेडर"]
    RATE -->|पास| ROUTE_CHECK{"रूट मिलान?"}

    ROUTE_CHECK -->|संवेदनशील ऑपरेशन<br/>पंजीकरण/ऑर्डर/भुगतान| POSTER["⑨ PosterVerify<br/>Redis टोकन सत्यापन<br/>स्लाइडर/पहेली/क्लिक"]
    ROUTE_CHECK -->|प्रमाणीकरण आवश्यक| JWT_START["⑩ JwtAuth"]
    ROUTE_CHECK -->|सार्वजनिक API| HENC

    POSTER --> JWT_START

    JWT_START --> JWT_CHECK{"Bearer टोकन<br/>HS256 हस्ताक्षर सत्यापन"}
    JWT_CHECK -->|अमान्य/समाप्त| E401["401 Unauthorized"]
    JWT_CHECK -->|मान्य| JWT_INJECT["इंजेक्शन request→userId"]

    JWT_INJECT --> HENC["⑪ HashidsEncode<br/>रिस्पॉन्स JSON पुनरावर्ती ट्रैवर्सल<br/>snowflake ID → hashid"]

    HENC --> CTRL["Controller<br/>व्यावसायिक लॉजिक प्रसंस्करण<br/>Model क्वेरी · सत्यापन · गणना"]

    CTRL --> ENC_RESP{"एन्क्रिप्टेड रिस्पॉन्स आवश्यक?"}

    ENC_RESP -->|हाँ| ENC["⑫ Encryption<br/>AES-256-CBC एन्क्रिप्शन<br/>X-Encrypted: 1 Header"]
    ENC_RESP -->|नहीं| RESP
    ENC --> RESP(["JSON Response<br/>{code, msg, data}<br/>+ CORS Headers<br/>+ X-Platform Header"])

