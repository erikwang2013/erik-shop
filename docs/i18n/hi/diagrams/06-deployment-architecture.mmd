graph TB
    subgraph Internet["इंटरनेट"]
        User["उपयोगकर्ता वैश्विक पहुँच"]
    end

    subgraph CDN["CDN एज परत"]
        EDGE["CDN Edge<br/>Cloudflare / CloudFront / Aliyun / Tencent<br/>ओरिजिन-पुल मॉडल<br/>https://{CDN_DOMAIN}{path}"]
    end

    subgraph VPS["क्लाउड सर्वर / VPS"]
        subgraph Docker["Docker Compose"]
            direction TB

            subgraph Net["erik-net Bridge Network"]
                direction TB

                NGX["Nginx :80 :443<br/>alpine<br/>रिवर्स प्रॉक्सी + SSL टर्मिनेशन<br/>स्टैटिक एसेट कैश<br/>location /app/admin/upload/<br/>expires 7d immutable"]

                subgraph PHP_Service["Service Container"]
                    SVC["PHP 8.3 + webman 2.1<br/>:8787 आंतरिक पोर्ट<br/>32 Worker (CPU×4)<br/>OPCache 128MB<br/>Snowflake Worker ID=1"]
                end

                subgraph PHP_Admin["Admin Container"]
                    ADM["PHP 8.3 + webman-admin<br/>:8788 आंतरिक पोर्ट<br/>LayUI + ECharts<br/>अंतर्निहित RBAC<br/>Snowflake Worker ID=2"]
                end

                subgraph DB["डेटाबेसकंटेनर"]
                    MYSQL[("MySQL 8.0 :3306<br/>117 टेबल (110 erik_ + 7 wa_)<br/>erik_data डेटा वॉल्यूम<br/>character-set utf8mb4")]
                    REDIS[("Redis 7 :6379<br/>erik_redis डेटा वॉल्यूम<br/>appendonly AOF पर्सिस्टेंट<br/>requirepass पासवर्ड")]
                    ES[("Elasticsearch 8.11 :9200<br/>erik_es डेटा वॉल्यूम<br/>आधिकारिक इमेज बहुभाषीखोज")]
                end
            end
        end

        subgraph Volumes["पर्सिस्टेंटडेटा वॉल्यूम"]
            V1["erik_data MySQL डेटा"]
            V2["erik_redis Redis डेटा"]
            V3["erik_es ES इंडेक्स"]
            V4["erik_logs एप्लिकेशन लॉग"]
            V5["admin_uploads Admin अपलोड<br/>(plugin/admin/public/upload)"]
            V6["service_public Service पब्लिक फाइलें<br/>(public/documents)"]
        end
    end

    subgraph External["बाहरी सेवाएँ"]
        Stripe["Stripe API<br/>PaymentIntent + 3DS"]
        PayPal["PayPal REST<br/>Orders API v2"]
        Klarna["Klarna API<br/>BNPL अभी खरीदें बाद में भुगतान"]
        SMTP["ईमेल सेवा<br/>बहुभाषी टेम्पलेट<br/>(email_templates तालिका)"]
    end

    User --> EDGE
    EDGE -->|admin को CNAME| NGX
    NGX -->|api.erik.xyz| SVC
    NGX -->|admin.erik.xyz| ADM
    SVC --> MYSQL
    SVC --> REDIS
    SVC --> ES
    SVC --> Stripe
    SVC --> PayPal
    SVC --> Klarna
    SVC --> SMTP
    ADM --> MYSQL
    ADM --> REDIS
    MYSQL -.-> V1
    REDIS -.-> V2
    ES -.-> V3
    SVC -.-> V4
    ADM -.-> V5
    SVC -.-> V6

