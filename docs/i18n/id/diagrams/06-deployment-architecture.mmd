graph TB
    subgraph Internet["Internet"]
        User["Pengguna akses global"]
    end

    subgraph VPS["Server Cloud / VPS"]
        subgraph Docker["Docker Compose"]
            direction TB

            subgraph Net["erik-net Bridge Network"]
                direction TB

                NGX["Nginx :80 :443<br/>alpine<br/>Proxy balik + terminasi SSL<br/>Cache aset statis"]

                subgraph PHP_Service["Service Container"]
                    SVC["PHP 8.3 + webman 2.1<br/>:8787 port internal<br/>32 Worker (CPU×4)<br/>OPCache 128MB<br/>Snowflake Worker ID=1"]
                end

                subgraph PHP_Admin["Admin Container"]
                    ADM["PHP 8.3 + webman-admin<br/>:8788 port internal<br/>LayUI + ECharts<br/>RBAC bawaan<br/>Snowflake Worker ID=2"]
                end

                subgraph DB["Kontainer Database"]
                    MYSQL[("MySQL 8.0 :3306<br/>117 tabel (110 erik_ + 7 wa_)<br/>Volume data erik_data<br/>character-set utf8mb4")]
                    REDIS[("Redis 7 :6379<br/>Volume data erik_redis<br/>Persistensi appendonly AOF<br/>requirepass kata sandi")]
                    ES[("Elasticsearch 8.11 :9200<br/>Volume data erik_es<br/>Citra resmi pencarian multibahasa")]
                end
            end
        end

        subgraph Volumes["Volume Data Persisten"]
            V1["erik_data data MySQL"]
            V2["erik_redis data Redis"]
            V3["erik_es indeks ES"]
            V4["erik_logs log aplikasi"]
        end
    end

    subgraph External["Layanan Eksternal"]
        Stripe["Stripe API<br/>PaymentIntent + 3DS"]
        PayPal["PayPal REST<br/>Orders API v2"]
        Klarna["Klarna API<br/>BNPL beli-sekarang-bayar-nanti"]
        SMTP["Layanan Email<br/>Template multibahasa<br/>(tabel email_templates)"]
    end

    User --> NGX
    NGX -->|api.erik.xyz| SVC
    NGX -->|admin.erik.xyz| ADM
    SVC --> MYSQL
    SVC --> REDIS
    SVC --> ES
    SVC --> Stripe
    SVC --> PayPal
    SVC --> Klarna
    SVC --> SMTP
    ADM --> MYSQL
    ADM --> REDIS
    MYSQL -.-> V1
    REDIS -.-> V2
    ES -.-> V3
    SVC -.-> V4

    style Internet fill:#e8eaf6
    style VPS fill:#e8f5e9
    style Docker fill:#f3e5f5
    style Net fill:#e1f5fe
    style PHP_Service fill:#c8e6c9
    style PHP_Admin fill:#fff9c4
    style DB fill:#fce4ec
    style Volumes fill:#efebe9
    style External fill:#e0f2f1
