graph TB
    subgraph Request["Pintu Masuk"]
        REQ["HTTP Request"]
    end

    subgraph L1["Lapisan 1: Batas Jaringan"]
        direction TB
        NG["Nginx proxy balik<br/>· Terminasi SSL/TLS<br/>· Batas ukuran body permintaan<br/>· Tolak koneksi langsung IP telanjang"]
        CORS_W["Daftar putih CORS<br/>· Access-Control-Allow-Origin<br/>· Batasan origin yang dapat dikonfigurasi"]
    end

    subgraph L2["Lapisan 2: Deteksi Serangan WAF<br/>(SecurityMiddleware)"]
        direction TB
        CT{"Validasi<br/>Content-Type"}
        BS{"Body Size<br/>≤ 10MB"}
        XSS{"Deteksi XSS<br/>13 regex"}
        SQLI{"Deteksi SQLi<br/>13 regex"}
        CRLF{"Injeksi CRLF<br/>Deteksi Header"}
        PATH_T{"Path traversal<br/>encoding/null byte"}
        XXE{"Injeksi entitas XXE<br/>ENTITY/DOCTYPE"}
        SSRF{"Pemalsuan SSRF<br/>Deteksi IP intranet"}
        FILE_CHK{"Unggah file<br/>daftar hitam/ekstensi ganda"}
        METHOD{"Metode HTTP<br/>Validasi daftar putih"}
        HOST{"Validasi<br/>Header Host"}

        CT -->|Tidak valid| E403["403"]
        CT -->|Lolos| BS
        BS -->|Melebihi batas| E413["413"]
        BS -->|Lolos| XSS
        XSS -->|Terkena| E40001["40001"]
        XSS -->|Lolos| SQLI
        SQLI -->|Terkena| E40002["40002"]
        SQLI -->|Lolos| CRLF
        CRLF -->|Terkena| E40003["40003"]
        CRLF -->|Lolos| PATH_T
        PATH_T -->|Terkena| E40004["40004"]
        PATH_T -->|Lolos| XXE
        XXE -->|Terkena| E40010["40010"]
        XXE -->|Lolos| SSRF
        SSRF -->|Terkena| E40011["40011"]
        SSRF -->|Lolos| FILE_CHK
        FILE_CHK -->|Terkena| E40009["40009"]
        FILE_CHK -->|Lolos| METHOD
        METHOD -->|Tidak valid| E40012["40012"]
        METHOD -->|Lolos| HOST
    end

    subgraph L3["Lapisan 3: Kontrol Lalu Lintas"]
        direction TB
        BRUTE["Proteksi brute force<br/>Penghitung Redis<br/>API: 10x/60dtk<br/>Admin: 5x/300dtk"]
        RATE["Rate limiting token bucket<br/>Jendela geser Redis ZSET<br/>6 aturan endpoint independen"]
        BRUTE --> RATE
    end

    subgraph L4["Lapisan 4: Autentikasi Identitas"]
        direction TB
        POSTER["Verifikasi manusia PosterVerify<br/>· Slider · Teka-teki · Klik<br/>· Dipicu registrasi/pesan/bayar"]
        JWT_AUTH["Autentikasi JWT<br/>· Tanda tangan HS256<br/>· Pemeriksaan kedaluwarsa<br/>· Refresh token ganda<br/>· Injeksi request→userId"]
        POSTER --> JWT_AUTH
    end

    subgraph L5["Lapisan 5: Keamanan Data"]
        direction TB
        HASHIDS["Obfuskasi ID Hashids<br/>· Permintaan: hashid→snowflake<br/>· Respons: snowflake→hashid<br/>· Mencegah enumerasi ID"]
        AES_ENC["Enkripsi AES-256-CBC<br/>· Transport: field sensitif body POST<br/>· Respons: header X-Encrypted<br/>· Database: trait Encryptable<br/>email/mobile/name/tax_id"]
        SENS_MASK["Desensitisasi data sensitif<br/>· Filter log password/token/secret<br/>· Desensitisasi respons error<br/>· Tidak membocorkan info internal"]
    end

    subgraph L6["Lapisan 6: Keamanan Respons"]
        direction TB
        SEC_HEADERS["Header keamanan respons HTTP<br/>· X-Content-Type-Options: nosniff<br/>· X-Frame-Options: DENY<br/>· X-XSS-Protection<br/>· Referrer-Policy<br/>· Permissions-Policy<br/>· Server disembunyikan<br/>· Cache-Control"]
    end

    subgraph Audit["Audit & Penelusuran"]
        direction LR
        PLATFORM["Pelacakan platform<br/>Header X-Platform<br/>Identifikasi 8 platform<br/>Catatan 6 tabel"]
        OP_LOG["Log operasi<br/>erik_operation_logs<br/>platform · user_id<br/>action · ip · ua"]
    end

    REQ --> NG
    NG --> CORS_W
    CORS_W --> L2
    HOST --> BRUTE
    RATE --> POSTER

    L5 --> L6
    L6 --> RESP(["Respons Aman"])

    PLATFORM -.-> OP_LOG
    L2 -.-> PLATFORM
    L4 -.-> PLATFORM

