graph TB
    subgraph Internet["インターネット"]
        User["ユーザー グローバルアクセス"]
    end

    subgraph VPS["クラウドサーバー / VPS"]
        subgraph Docker["Docker Compose"]
            direction TB

            subgraph Net["erik-net Bridge Network"]
                direction TB

                NGX["Nginx :80 :443<br/>alpine<br/>リバースプロキシ + SSL 終端<br/>静的リソースキャッシュ"]

                subgraph PHP_Service["Service Container"]
                    SVC["PHP 8.3 + webman 2.1<br/>:8787 内部ポート<br/>32 Worker (CPU×4)<br/>OPCache 128MB<br/>Snowflake Worker ID=1"]
                end

                subgraph PHP_Admin["Admin Container"]
                    ADM["PHP 8.3 + webman-admin<br/>:8788 内部ポート<br/>LayUI + ECharts<br/>組み込み RBAC<br/>Snowflake Worker ID=2"]
                end

                subgraph DB["データベースコンテナ"]
                    MYSQL[("MySQL 8.0 :3306<br/>117 テーブル (110 erik_ + 7 wa_)<br/>erik_data データボリューム<br/>character-set utf8mb4")]
                    REDIS[("Redis 7 :6379<br/>erik_redis データボリューム<br/>appendonly AOF 永続化<br/>requirepass パスワード")]
                    ES[("Elasticsearch 8.11 :9200<br/>erik_es データボリューム<br/>公式イメージ 多言語検索")]
                end
            end
        end

        subgraph Volumes["永続化データボリューム"]
            V1["erik_data MySQL データ"]
            V2["erik_redis Redis データ"]
            V3["erik_es ES インデックス"]
            V4["erik_logs アプリケーションログ"]
        end
    end

    subgraph External["外部サービス"]
        Stripe["Stripe API<br/>PaymentIntent + 3DS"]
        PayPal["PayPal REST<br/>Orders API v2"]
        Klarna["Klarna API<br/>BNPL 後払い"]
        SMTP["メールサービス<br/>多言語テンプレート<br/>(email_templates テーブル)"]
    end

    User --> NGX
    NGX -->|api.erik.xyz| SVC
    NGX -->|admin.erik.xyz| ADM
    SVC --> MYSQL
    SVC --> REDIS
    SVC --> ES
    SVC --> Stripe
    SVC --> PayPal
    SVC --> Klarna
    SVC --> SMTP
    ADM --> MYSQL
    ADM --> REDIS
    MYSQL -.-> V1
    REDIS -.-> V2
    ES -.-> V3
    SVC -.-> V4

    style Internet fill:#e8eaf6
    style VPS fill:#e8f5e9
    style Docker fill:#f3e5f5
    style Net fill:#e1f5fe
    style PHP_Service fill:#c8e6c9
    style PHP_Admin fill:#fff9c4
    style DB fill:#fce4ec
    style Volumes fill:#efebe9
    style External fill:#e0f2f1
