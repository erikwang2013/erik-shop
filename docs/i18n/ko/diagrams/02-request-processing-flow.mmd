graph TB
    START(["HTTP 요청 도착"]) --> CORS["① Cors<br/>Access-Control-* 응답 헤더<br/>OPTIONS 사전 요청 200 반환"]

    CORS --> SEC["② Security 공격 탐지<br/>━━━━━━━━━━━━━━━"]
    SEC --> SEC1{"Content-Type<br/>유효?"}
    SEC1 -->|아니요| E403["403 Forbidden"]
    SEC1 -->|예| SEC2{"Body Size<br/>≤ 10MB?"}
    SEC2 -->|아니요| E413["413 Too Large"]
    SEC2 -->|예| SEC3{"XSS 탐지<br/>13개 규칙"}
    SEC3 -->|탐지됨| E40001["40001 XSS 차단"]
    SEC3 -->|통과| SEC4{"SQLi 탐지<br/>13개 규칙"}
    SEC4 -->|탐지됨| E40002["40002 SQLi 차단"]
    SEC4 -->|통과| SEC5{"CRLF 탐지<br/>Header 주입"}
    SEC5 -->|탐지됨| E40003["40003 CRLF 차단"]
    SEC5 -->|통과| SEC6{"경로 탐색<br/>탐지"}
    SEC6 -->|탐지됨| E40004["40004 Path 차단"]
    SEC6 -->|통과| SEC_PASS["보안 검사 통과"]

    SEC_PASS --> PLAT["③ Platform<br/>X-Platform Header<br/>+ UA 폴백 인식<br/>8개 플랫폼 출처"]

    PLAT --> GEO["④ GeoIp<br/>MaxMind GeoIP2<br/>비로그인 사용자<br/>지역/통화/언어 인식"]

    GEO --> LOCALE["⑤ Locale<br/>Accept-Language 파싱<br/>5개 언어 정확 매칭 → 폴백 → 기본"]

    LOCALE --> HDEC["⑥ HashidsDecode<br/>요청의 *_id 필드<br/>hashid → snowflake ID"]

    HDEC --> VER["⑦ VersionRoute<br/>API-Version Header<br/>→ v1/v2 네임스페이스 라우팅"]

    VER --> RATE["⑧ RateLimit<br/>Redis ZSET 슬라이딩 윈도우<br/>토큰 버킷 속도 제한"]

    RATE -->|초과| E429["429 Too Many Requests<br/>Retry-After 응답 헤더"]
    RATE -->|통과| ROUTE_CHECK{"라우팅 매칭?"}

    ROUTE_CHECK -->|민감 작업<br/>가입/주문/결제| POSTER["⑨ PosterVerify<br/>Redis 검증 token<br/>슬라이더/퍼즐/클릭"]
    ROUTE_CHECK -->|인증 필요| JWT_START["⑩ JwtAuth"]
    ROUTE_CHECK -->|공개 인터페이스| HENC

    POSTER --> JWT_START

    JWT_START --> JWT_CHECK{"Bearer Token<br/>HS256 서명 검증"}
    JWT_CHECK -->|무효/만료| E401["401 Unauthorized"]
    JWT_CHECK -->|유효| JWT_INJECT["request→userId 주입"]

    JWT_INJECT --> HENC["⑪ HashidsEncode<br/>응답 JSON 재귀 순회<br/>snowflake ID → hashid"]

    HENC --> CTRL["Controller<br/>비즈니스 로직 처리<br/>Model 조회 · 검증 · 계산"]

    CTRL --> ENC_RESP{"암호화 응답 필요?"}

    ENC_RESP -->|예| ENC["⑫ Encryption<br/>AES-256-CBC 암호화<br/>X-Encrypted: 1 Header"]
    ENC_RESP -->|아니요| RESP
    ENC --> RESP(["JSON Response<br/>{code, msg, data}<br/>+ CORS Headers<br/>+ X-Platform Header"])

    style SEC fill:#ffcdd2
    style RATE fill:#fff9c4
    style POSTER fill:#ffe0b2
    style JWT_START fill:#c8e6c9
    style CTRL fill:#bbdefb
    style START fill:#e8eaf6
    style RESP fill:#e8eaf6
    style E403 fill:#ff5252,color:#fff
    style E413 fill:#ff5252,color:#fff
    style E40001 fill:#ff5252,color:#fff
    style E40002 fill:#ff5252,color:#fff
    style E40003 fill:#ff5252,color:#fff
    style E40004 fill:#ff5252,color:#fff
    style E429 fill:#ff9800,color:#fff
    style E401 fill:#ff5252,color:#fff
