graph TB
    subgraph Request["Вход"]
        REQ["HTTP Request"]
    end

    subgraph L1["Первый уровень: сетевой периметр"]
        direction TB
        NG["Nginx обратный прокси<br/>· SSL/TLS-терминатор<br/>· Ограничение размера тела запроса<br/>· Запрет прямого подключения по голому IP"]
        CORS_W["Белый список CORS<br/>· Access-Control-Allow-Origin<br/>· Настраиваемое ограничение origin"]
    end

    subgraph L2["Второй уровень: WAF-обнаружение атак<br/>(SecurityMiddleware)"]
        direction TB
        CT{"Content-Type<br/>проверка"}
        BS{"Body Size<br/>≤ 10MB"}
        XSS{"XSS-проверка<br/>13 регулярных выражений"}
        SQLI{"SQLi-проверка<br/>13 регулярных выражений"}
        CRLF{"CRLF-инъекция<br/>проверка Header"}
        PATH_T{"Обход пути<br/>кодирование/null byte"}
        XXE{"XXE-инъекция сущностей<br/>ENTITY/DOCTYPE"}
        SSRF{"SSRF-подделка<br/>проверка внутренних IP"}
        FILE_CHK{"Загрузка файлов<br/>чёрный список/двойное расширение"}
        METHOD{"HTTP-методы<br/>проверка белого списка"}
        HOST{"Header Host<br/>проверка"}

        CT -->|Недопустимо| E403["403"]
        CT -->|Пройдено| BS
        BS -->|Превышение| E413["413"]
        BS -->|Пройдено| XSS
        XSS -->|Сработало| E40001["40001"]
        XSS -->|Пройдено| SQLI
        SQLI -->|Сработало| E40002["40002"]
        SQLI -->|Пройдено| CRLF
        CRLF -->|Сработало| E40003["40003"]
        CRLF -->|Пройдено| PATH_T
        PATH_T -->|Сработало| E40004["40004"]
        PATH_T -->|Пройдено| XXE
        XXE -->|Сработало| E40010["40010"]
        XXE -->|Пройдено| SSRF
        SSRF -->|Сработало| E40011["40011"]
        SSRF -->|Пройдено| FILE_CHK
        FILE_CHK -->|Сработало| E40009["40009"]
        FILE_CHK -->|Пройдено| METHOD
        METHOD -->|Недопустимо| E40012["40012"]
        METHOD -->|Пройдено| HOST
    end

    subgraph L3["Третий уровень: контроль трафика"]
        direction TB
        BRUTE["Защита от перебора паролей<br/>счётчики Redis<br/>API: 10 раз/60s<br/>Admin: 5 раз/300s"]
        RATE["Лимитирование токен-бакетом<br/>ZSET Redis, скользящее окно<br/>Независимые правила 6 конечных точек"]
        BRUTE --> RATE
    end

    subgraph L4["Четвёртый уровень: аутентификация"]
        direction TB
        POSTER["PosterVerify человеко-машинная проверка<br/>· Слайдер · Пазл · Клик<br/>· Запуск при регистрации/заказе/оплате"]
        JWT_AUTH["JWT-аутентификация<br/>· Подпись HS256<br/>· Проверка срока действия<br/>· Обновление пары токенов<br/>· Внедрение request→userId"]
        POSTER --> JWT_AUTH
    end

    subgraph L5["Пятый уровень: безопасность данных"]
        direction TB
        HASHIDS["Hashids обфускация ID<br/>· Запрос: hashid→snowflake<br/>· Ответ: snowflake→hashid<br/>· Защита от перебора ID"]
        AES_ENC["Шифрование AES-256-CBC<br/>· Транспорт: чувствительные поля POST body<br/>· Ответ: header X-Encrypted<br/>· БД: trait Encryptable<br/>email/mobile/name/tax_id"]
        SENS_MASK["Маскирование чувствительных данных<br/>· Фильтрация password/token/secret в логах<br/>· Маскирование в ошибочных ответах<br/>· Без раскрытия внутренней информации"]
    end

    subgraph L6["Шестой уровень: безопасность ответов"]
        direction TB
        SEC_HEADERS["HTTP-безопасные заголовки ответа<br/>· X-Content-Type-Options: nosniff<br/>· X-Frame-Options: DENY<br/>· X-XSS-Protection<br/>· Referrer-Policy<br/>· Permissions-Policy<br/>· Скрытие Server<br/>· Cache-Control"]
    end

    subgraph Audit["Аудит и трассировка"]
        direction LR
        PLATFORM["Отслеживание платформ<br/>header X-Platform<br/>идентификация 8 платформ<br/>запись в 6 таблиц"]
        OP_LOG["Журнал операций<br/>erik_operation_logs<br/>platform · user_id<br/>action · ip · ua"]
    end

    REQ --> NG
    NG --> CORS_W
    CORS_W --> L2
    HOST --> BRUTE
    RATE --> POSTER

    L5 --> L6
    L6 --> RESP(["Безопасный ответ"])

    PLATFORM -.-> OP_LOG
    L2 -.-> PLATFORM
    L4 -.-> PLATFORM

    style L1 fill:#e3f2fd
    style L2 fill:#ffcdd2
    style L3 fill:#fff9c4
    style L4 fill:#c8e6c9
    style L5 fill:#e1bee7
    style L6 fill:#b2dfdb
    style Audit fill:#f5f5f5
    style E403 fill:#ff5252,color:#fff
    style E413 fill:#ff5252,color:#fff
    style E40001 fill:#ff5252,color:#fff
    style E40002 fill:#ff5252,color:#fff
    style E40003 fill:#ff5252,color:#fff
    style E40004 fill:#ff5252,color:#fff
    style E40009 fill:#ff5252,color:#fff
    style E40010 fill:#ff5252,color:#fff
    style E40011 fill:#ff5252,color:#fff
