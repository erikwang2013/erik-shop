# 跨境电商平台 - 环境变量模板
# 复制为 .env 并修改实际值
# =============================================================

# 应用环境
APP_ENV=production
APP_URL=http://localhost

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erik_shop
DB_USER=erik
DB_PASS=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200
ES_USER=
ES_PASS=

# JWT Token (256bit密钥)
JWT_SECRET=change_me_to_random_256bit_string

# Hashids 盐值
HASHIDS_SALT=change_me_hashids_salt

# AES 加密密钥 (32字节)
ENCRYPTION_KEY=change_me_32_byte_key_here!!

# Snowflake
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# 支付网关
PAYMENT_DEFAULT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MODE=sandbox

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

KLARNA_USERNAME=
KLARNA_PASSWORD=
KLARNA_REGION=europe
KLARNA_MODE=sandbox

# MaxMind GeoIP
MAXMIND_LICENSE_KEY=

# MySQL Docker
MYSQL_ROOT_PASS=change_me_root
