{
  "name": "erik/shop-service",
  "type": "project",
  "keywords": [
    "cross-border",
    "ecommerce",
    "api"
  ],
  "homepage": "https://erik.xyz",
  "license": "proprietary",
  "description": "Cross-Border E-Commerce Service API.",
  "authors": [
    {
      "name": "erik",
      "email": "erik@erik.xyz",
      "homepage": "https://erik.xyz",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "webman/database": "^2.0",
    "illuminate/database": "^11.0",
    "illuminate/redis": "^11.0",
    "illuminate/events": "^11.0",
    "erikwang2013/snowflake-php": "^1.0",
    "erikwang2013/hashids": "^1.0",
    "erikwang2013/jwt-webman": "^1.0",
    "erikwang2013/season": "^1.0",
    "erikwang2013/encryption": "^1.0",
    "erikwang2013/encryptable": "^1.0",
    "erikwang2013/poster-php": "^1.0",
    "erikwang2013/webman-scout": "^1.0",
    "elasticsearch/elasticsearch": "^8.0",
    "phpoffice/phpspreadsheet": "^2.0",
    "barryvdh/laravel-dompdf": "^3.0",
    "guzzlehttp/guzzle": "^7.0",
    "stripe/stripe-php": "^15.0",
    "maxmind-db/reader": "^1.0"
  },
  "suggest": {
    "ext-event": "For better performance."
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "post-create-project-cmd": [
      "support\\Setup::run"
    ],
    "setup-webman": [
      "support\\Setup::run"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
